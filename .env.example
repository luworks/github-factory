# Build-time public path; keep the trailing slash.
MOONSHOT_BASE_PATH=/github-factory/
# Server only. Copy to .env; never expose values via VITE_ variables.
MOONSHOT_PROVIDER=muse
MOONSHOT_MODEL=gpt-6.1-sol
MOONSHOT_API_BASE_URL=https://api.openai.com/v1
MOONSHOT_API_KEY=
MOONSHOT_META_API_KEY=
MOONSHOT_META_API_BASE_URL=
MOONSHOT_META_MODEL=
MOONSHOT_BUDGET_USD=0
MOONSHOT_DATA_DIR=.data
GITHUB_TOKEN=
# Exact browser origin accepted behind a trusted proxy; never trust forwarded headers.
MOONSHOT_PUBLIC_ORIGIN=
# Persisted, deployment-wide upstream attempts/hour, including GET imports and retries.
MOONSHOT_GITHUB_REQUESTS_PER_HOUR=45

# Public deployments with a positive paid budget MUST use an existing absolute
# authoritative ai-budget.sqlite path. Never initialize/fork a paid ledger.
MOONSHOT_BUDGET_LEDGER_PATH=
# Conservative cap: at most USD0.30 per rolling hour, accounting ceiling10CNY/USD.
MOONSHOT_HOURLY_BUDGET_USD=0.30
# Private shared gateway secret (>=32 chars); matches Worker FACTORY_GATEWAY_SECRET.
MOONSHOT_GATEWAY_SECRET=
MOONSHOT_IP_REQUESTS_PER_MINUTE=10
MOONSHOT_IP_COLLECTIONS_PER_HOUR=6
MOONSHOT_IP_AI_PER_HOUR=2
MOONSHOT_AI_CALLS_PER_HOUR=6

# Public source worlds only; paid ledger and admission quotas stay local SQLite.
MOONSHOT_WORLD_STORE=sqlite
# D1 mode requires the private fixed-operation gateway bridge, never a CF API token.
MOONSHOT_D1_STORAGE_URL=https://chaorders.com/github-factory/_storage
MOONSHOT_D1_STORAGE_SECRET=
# Ops-only temporary migration HOLD; cached reads remain available.
MOONSHOT_WORLD_WRITES_HOLD=0
