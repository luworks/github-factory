# Build-time public path; keep the trailing slash.
MOONSHOT_BASE_PATH=/github-factory/
# Server only. Copy to .env; never expose values via VITE_ variables.
MOONSHOT_PROVIDER=muse
MOONSHOT_MODEL=gpt-6.1-sol
MOONSHOT_API_BASE_URL=http://127.0.0.1:18317/v1
MOONSHOT_API_KEY=
MOONSHOT_META_API_KEY=
MOONSHOT_META_API_BASE_URL=
MOONSHOT_META_MODEL=
MOONSHOT_BUDGET_USD=0
MOONSHOT_DATA_DIR=.data
GITHUB_TOKEN=
