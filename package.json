{
  "name": "github-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --no-env-file x --bun --no-install vite --host 127.0.0.1 --port 4178 --strictPort",
    "build": "bun --no-env-file x --bun --no-install vite build",
    "start": "bun --no-env-file .output/server/index.mjs",
    "check": "bun --no-env-file x --bun --no-install tsc --noEmit",
    "test": "bun --no-env-file test test/",
    "test:browser": "bun --no-env-file x --bun --no-install playwright test",
    "prefetch": "bun scripts/prefetch.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "lucide-react": "^0.468.0",
    "nitro": "3.0.260610-beta",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "MIT",
  "description": "Turn public GitHub repositories into explorable worlds.",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/luworks/github-factory.git"
  },
  "homepage": "https://chaorders.com/github-factory"
}
